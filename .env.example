# ---------------------------------------------------------------
# SubTrack settings.  Copy this file to ".env" (setup.bat does it for you)
# and change the values below to match YOUR computer.
# ---------------------------------------------------------------

# "mssql"  = Microsoft SQL Server (the real setup)
# "sqlite" = a local file, no server needed (backup option for emergencies)
DB_MODE=mssql

# --- SQL Server -------------------------------------------------
# Must match the "Server name" you type when you open SSMS.
# Examples:  localhost\SQLEXPRESS   DESKTOP-ABC123\SQLEXPRESS   .\SQLEXPRESS   (localdb)\MSSQLLocalDB
MSSQL_SERVER=localhost\SQLEXPRESS

# SubTrack creates this database for you automatically.
MSSQL_DATABASE=SubTrack

# Run:  python -m app.database.diagnose   to see which drivers you have installed.
# Common values: "ODBC Driver 17 for SQL Server" or "ODBC Driver 18 for SQL Server"
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# yes = Windows Authentication (same as SSMS "Windows Authentication").
# no  = SQL login: fill in MSSQL_USER and MSSQL_PASSWORD below.
MSSQL_TRUSTED_CONNECTION=yes
MSSQL_USER=
MSSQL_PASSWORD=

# --- SQLite backup option (only used when DB_MODE=sqlite) --------
SQLITE_PATH=subtrack.db

# --- Money ------------------------------------------------------
# The currency all totals are shown in by default (you can switch it in the app too).
BASE_CURRENCY=PKR

# true  = download live exchange rates from the internet
# false = always use the built-in approximate rates
LIVE_RATES=true
